# ---------------------------------------------------------------------------
# Copy file này thành .env rồi điền giá trị thật. Không commit .env.
# ---------------------------------------------------------------------------

# APP_URL: nơi ứng dụng được host. Dùng cho link tự tham chiếu / OAuth callback.
APP_URL="http://localhost:3000"

# --- PostgreSQL (docker compose) -------------------------------------------
POSTGRES_DB=vietfashion
POSTGRES_USER=vietfashion
POSTGRES_PASSWORD=doi_mat_khau_nay
POSTGRES_PORT=5433

# --- FastAPI ---------------------------------------------------------------
# Express forward request của browser sang đây.
FASTAPI_PORT=8000
FASTAPI_URL=http://127.0.0.1:8000

# ---------------------------------------------------------------------------
# LLM: ĐANG TẮT — chưa cần khai báo model.
#
# LLM chỉ dùng cho endpoint tư vấn (POST /advice). Engine chấm điểm và chọn
# outfit (POST /recommendations) KHÔNG bao giờ gọi LLM, nên để none thì toàn bộ
# tính năng gợi ý phối đồ vẫn chạy đầy đủ và không tốn một đồng nào.
#
# Với none, /advice vẫn trả tư vấn theo luật suy từ điểm engine.
# Phần UI tư vấn cũng đang tắt bằng cờ ENABLE_AI_ADVICE trong
# src/components/Step4CompleteOutfit.tsx.
# ---------------------------------------------------------------------------
LLM_PROVIDER=none

# ---------------------------------------------------------------------------
# KHI NÀO CẦN BẬT
#   1. Đổi LLM_PROVIDER thành: gemini | openai | anthropic | openrouter
#   2. Bỏ comment đúng cặp key/model của provider đó bên dưới
#   3. Đổi ENABLE_AI_ADVICE thành true trong Step4CompleteOutfit.tsx
#   4. Kiểm bằng: GET /api/llm/status  (hoặc FastAPI GET /llm/health)
#
# Tên model thay đổi theo thời gian — đối chiếu lại trong trang model list của
# provider trước khi dùng. Tên model sai là lỗi thường gặp nhất; giờ nó báo rõ
# trong llm_error thay vì bị fallback che mất.
#
# Gemini     — https://ai.google.dev/gemini-api/docs/models
# GEMINI_API_KEY=""
# GEMINI_MODEL=gemini-2.5-flash
#
# OpenAI     — https://platform.openai.com/docs/models
# OPENAI_API_KEY=""
# OPENAI_MODEL=gpt-4.1-mini
#
# Anthropic  — https://docs.claude.com/en/docs/about-claude/models
# ANTHROPIC_API_KEY=""
# ANTHROPIC_MODEL=claude-sonnet-4-5
#
# OpenRouter — https://openrouter.ai/models
# OPENROUTER_API_KEY=""
# OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
#
# Tuỳ chọn chung cho mọi provider:
# LLM_TIMEOUT_SECONDS=30
# LLM_TEMPERATURE=0.2
# LLM_MAX_TOKENS=1200
# ---------------------------------------------------------------------------
